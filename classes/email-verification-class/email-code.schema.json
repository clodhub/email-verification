{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "com.clodhub/email-code",
  "x-version": "1.0.0",
  "description": "A document of the emailCodes collection as a records export writes it: the code an address was last sent.",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "createdAt": {
      "$ref": "#/$defs/date"
    },
    "expiresAt": {
      "$ref": "#/$defs/date"
    },
    "failures": {
      "type": "integer",
      "minimum": 0,
      "description": "Wrong codes given for the address since this code was sent."
    }
  },
  "required": [
    "_id",
    "email",
    "code",
    "createdAt",
    "expiresAt",
    "failures"
  ],
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "object",
      "properties": {
        "$date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$date"
      ],
      "additionalProperties": false,
      "description": "A date as a records export writes it."
    }
  },
  "x-clodhub-modules": {}
}
